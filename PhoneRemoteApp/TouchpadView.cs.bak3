using Microsoft.Maui.Controls.Shapes;
using Microsoft.Maui.Graphics;

namespace PhoneRemoteApp;

/// <summary>触控板事件参数</summary>
public class ClickArgs : EventArgs
{
    public ClickArgs(string button, string action)
    {
        Button = button;
        Action = action;
    }

    /// <summary>left / right</summary>
    public string Button { get; }

    /// <summary>click / dblclick</summary>
    public string Action { get; }
}

/// <summary>流动的迷幻霓虹光晕（黑底上缓慢漂移的虹彩渐变）</summary>
public class AuroraDrawable : IDrawable
{
    private double _t;

    public void Tick() => _t += 0.028;   // 动画速度：数字越大动得越快（原 0.014 太慢，看着像没动）

    public void Draw(ICanvas canvas, RectF dirtyRect)
    {
        var w = dirtyRect.Width;
        var h = dirtyRect.Height;
        if (w <= 0 || h <= 0) return;

        // 深灰底
        canvas.FillColor = Color.FromArgb("#0d0d11");
        canvas.FillRectangle(dirtyRect);

        // 左上角约 1/3 区域的弥散光晕（星云感）：青绿 / 深靛紫 / 暖琥珀 三色超大半径模糊交融
        // ★ 全区域弥散：中心移到整个触控板中央，半径放大到铺满
        var r = MathF.Min(w, h) * 0.3f;   // ← 想更"满"就加大，更淡就减小
        var cx = w * 0.5f;
        var cy = h * 0.5f;

        // 颜色流动（相位/速度调快 → 几秒就能看到色相在呼吸）
        var teal = HsvToColor(172 + 30 * Math.Sin(_t * 0.5), 0.85, 0.98);
        var indigo = HsvToColor(258 + 26 * Math.Sin(_t * 0.42 + 1.5), 0.80, 0.95);
        var amber = HsvToColor(40 + 22 * Math.Sin(_t * 0.6 + 3), 0.90, 0.98);

        // 光团中心缓慢漂移 → 海浪涌动感
        var wob = (float)Math.Sin(_t * 0.8) * MathF.Min(w, h) * 0.16f;   // 漂移更快幅度更大 → 明显在动

        // 三团光按对角线散开铺满整块：左下 / 中央 / 右上
        DrawBlob(canvas, cx - w * 0.24f + wob, cy + h * 0.22f - wob, r * 1.1f, teal);
        DrawBlob(canvas, cx, cy, r * 1.2f, indigo);
        DrawBlob(canvas, cx + w * 0.24f - wob, cy - h * 0.22f + wob, r * 1.1f, amber);
    }

    /// <summary>高斯衰减的光晕团：中心实色 → 边缘平滑淡出（模拟超大半径模糊，无硬边）</summary>
    private static void DrawBlob(ICanvas canvas, float x, float y, float r, Color color)
    {
        const int rings = 18;                     // 圈数越多越细腻
        for (var i = 0; i < rings; i++)
        {
            var k = i / (float)(rings - 1);       // 0=中心 … 1=边缘
            var radius = r * (1f - k * 0.90f);
            var alpha = 0.32f * MathF.Exp(-(k / 0.65f) * (k / 0.65f)); // 0.45 越大衰减越慢=越弥散
            canvas.FillColor = color.WithAlpha(alpha);
            canvas.FillCircle(x, y, radius);
        }
    }

    private static Color HsvToColor(double h, double s, double v)
    {
        var c = v * s;
        var x = c * (1 - Math.Abs(h / 60 % 2 - 1));
        var m = v - c;
        (double R, double G, double B) rgb = h switch
        {
            < 60 => (c, x, 0),
            < 120 => (x, c, 0),
            < 180 => (0, c, x),
            < 240 => (0, x, c),
            < 300 => (x, 0, c),
            _ => (c, 0, x),
        };
        return Color.FromRgb((rgb.R + m) * 255, (rgb.G + m) * 255, (rgb.B + m) * 255);
    }
}

/// <summary>
/// 触控板：滑动=移动光标，轻点=左键，连点两次=双击，长按(≥0.5秒)=右键，双指滑动=滚轮。
/// 手势由安卓原生触摸跟踪实现（Platforms/Android/GestureTracker），背景为流动的迷幻霓虹。
/// </summary>
public class TouchpadView : Border
{
    /// <summary>相对位移（像素）</summary>
    public event EventHandler<Point>? MoveRequested;

    /// <summary>点击事件</summary>
    public event EventHandler<ClickArgs>? ClickRequested;

    /// <summary>滚轮事件（正数=向上）</summary>
    public event EventHandler<int>? ScrollRequested;

    // 供原生手势跟踪（GestureTracker）触发事件
    public void RaiseMove(double dx, double dy) => MoveRequested?.Invoke(this, new Point((float)dx, (float)dy));
    public void RaiseClick(string button, string action) => ClickRequested?.Invoke(this, new ClickArgs(button, action));
    public void RaiseScroll(int delta) => ScrollRequested?.Invoke(this, delta);

    private readonly AuroraDrawable _aurora = new();
    private IDispatcherTimer? _timer;

    public TouchpadView()
    {
        BackgroundColor = Color.FromArgb("#0a0a0a");
        StrokeShape = new RoundRectangle { CornerRadius = 10 };
        Stroke = Color.FromArgb("#1f1f1f");
        StrokeThickness = 1;
        Padding = 0;

        // 迷幻背景（30fps 动画）
        var gfx = new GraphicsView { Drawable = _aurora };
        Content = gfx;
        Loaded += OnLoaded;
    }

    private void OnLoaded(object? sender, EventArgs e)
    {
        _timer = Dispatcher.CreateTimer();
        _timer.Interval = TimeSpan.FromMilliseconds(33);
        _timer.Tick += (_, _) =>
        {
            _aurora.Tick();
            (Content as GraphicsView)?.Invalidate();
        };
        _timer.Start();
    }
}
