<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PhoneRemoteApp.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:PhoneRemoteApp"
    BackgroundColor="#0a0a0a"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <!--  底部鼠标三键：简简单单的空白黑色矩形  -->
        <Style x:Key="MouseBtn" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#1c1c1c" />
            <Setter Property="BorderColor" Value="#4a4a4a" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HeightRequest" Value="76" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#262626" />
                                <Setter Property="Scale" Value="0.96" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">

        <!--  ============ 触控板 + 滚轮条 ============  -->
        <Grid Grid.Row="0" Margin="0,0,0,0">

            <!--  迷幻霓虹触控板  -->
            <local:TouchpadView
                x:Name="Touchpad"
                ClickRequested="OnTouchpadClick"
                MoveRequested="OnTouchpadMove"
                ScrollRequested="OnTouchpadScroll" />

            <!--  右侧滚动侧边栏  -->
            <BoxView
                x:Name="ScrollSidebar"
                Margin="0,0,10,0"
                HeightRequest="390"
                HorizontalOptions="End"
                VerticalOptions="Start"
                WidthRequest="44"
                Color="AliceBlue">
                <BoxView.GestureRecognizers>
                    <PanGestureRecognizer PanUpdated="OnSidebarPan" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <!--  左上角：设置（纯图标，无按钮底色）  -->
            <Image
                Margin="14"
                HeightRequest="24"
                HorizontalOptions="Start"
                Opacity="0.45"
                Source="settings.png"
                VerticalOptions="Start"
                WidthRequest="24">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSettingsClicked" />
                </Image.GestureRecognizers>
            </Image>

            <!--  右上角：唤出键盘（纯图标，无按钮底色）  -->
            <Image
                Margin="0,14,70,0"
                HeightRequest="24"
                HorizontalOptions="End"
                Opacity="0.45"
                Source="keyboard.png"
                VerticalOptions="Start"
                WidthRequest="24">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnKeyboardClicked" />
                </Image.GestureRecognizers>
            </Image>

            <!--  隐藏输入（无输入条，全透明；多行编辑器保证回车不收起键盘，打字实时镜像到电脑）  -->
            <Editor
                x:Name="HiddenInput"
                HeightRequest="1"
                HorizontalOptions="End"
                InputTransparent="False"
                IsVisible="True"
                Opacity="0"
                TextChanged="OnHiddenTextChanged"
                VerticalOptions="End"
                WidthRequest="1" />
        </Grid>

        <!--  ============ 底部三键 2 : 1 : 2（空白黑色矩形） ============  -->
        <Grid
            Grid.Row="0"
            Padding="8,0,8,6"
            ColumnDefinitions="2*,1*,2*"
            ColumnSpacing="6"
            HorizontalOptions="Fill"
            VerticalOptions="End">
            <Button
                x:Name="LeftBtn"
                Pressed="OnLeftPressed"
                Released="OnLeftReleased"
                Style="{StaticResource MouseBtn}" />
            <Button
                x:Name="MiddleBtn"
                Grid.Column="1"
                Pressed="OnMiddlePressed"
                Released="OnMiddleReleased"
                Style="{StaticResource MouseBtn}" />
            <Button
                x:Name="RightBtn"
                Grid.Column="2"
                Pressed="OnRightPressed"
                Released="OnRightReleased"
                Style="{StaticResource MouseBtn}" />
        </Grid>

        <!--  ============ 键盘预留区：一片空的黑色区域（键盘弹出时只覆盖这里） ============  -->
        <Grid
            x:Name="KeyboardReserve"
            Grid.Row="2"
            BackgroundColor="#0a0a0a">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnKeyboardClicked" />
            </Grid.GestureRecognizers>
        </Grid>

    </Grid>
</ContentPage>
